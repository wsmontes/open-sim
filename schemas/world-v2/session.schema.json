{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://open-sim.local/schemas/world-v2/session.schema.json",
 "title": "OpenSim 0.1 session descriptor (§23)",
 "description": "A session is an object of type `session` that `join` resolves; the descriptor is enough for a client to negotiate realtime networking, and session traffic is not history (§24). This client publishes the descriptor with the extensions it needs (the world, the branch, the epoch and the head it started from), so the body stays open: a client that does not know them carries them.",
 "type": "object",
 "required": ["osim", "type", "id", "actor", "body"],
 "additionalProperties": false,
 "properties": {
  "osim": {"const": "0.1"},
  "type": {"const": "session"},
  "id": {"type": "string", "pattern": "^osim:session:[A-Za-z0-9_-]{1,80}$"},
  "actor": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s\\u0000-\\u001f]{1,220}$"},
  "body": {
   "type": "object",
   "additionalProperties": true,
   "required": ["space", "timeline", "participants", "mode"],
   "properties": {
    "space": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]{1,220}$"},
    "timeline": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]{1,220}$"},
    "participants": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]{1,220}$"}},
    "mode": {"enum": ["realtime", "async"]},
    "epoch": {"type": "integer", "minimum": 0},
    "startedAt": {"type": "string"}
   }
  }
 }
}
