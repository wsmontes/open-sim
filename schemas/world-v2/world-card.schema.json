{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://open-sim.local/schemas/world-v2/world-card.schema.json",
 "title": "Public world card",
 "description": "The document somebody shares so another person can find a world. It carries only what it declares — a title, a view URI, a link, the terms of the data it rests on and the capability declarations its issuer publishes — so a key, a snapshot, a grant or a proof has nowhere to ride along. `view` is the §40 URI a client opens; `link` is how the visitor lands on a version. Nothing here addresses a community: sharing is a person's decision, and an ActivityPub document built from this card has no recipients.",
 "type": "object",
 "required": ["kind", "version", "id", "world", "title", "view", "actor", "link", "terms", "capabilities"],
 "additionalProperties": false,
 "properties": {
  "kind": {"const": "world-card"},
  "version": {"const": 1},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s\\u0000-\\u001f]{1,220}$"},
  "world": {"$ref": "world-address.schema.json"},
  "title": {"type": "string", "minLength": 1, "maxLength": 600},
  "view": {"type": "string", "pattern": "^osim://[^\\s\\u0000-\\u001f]{1,220}$"},
  "actor": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s\\u0000-\\u001f]{1,220}$"},
  "link": {"$ref": "world-link.schema.json"},
  "terms": {"type": "array", "items": {"$ref": "dataset-term.schema.json"}},
  "capabilities": {"type": "array", "items": {"$ref": "capability.schema.json"}},
  "summary": {"type": "string", "minLength": 1, "maxLength": 600},
  "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
  "publishedAt": {"type": "string", "minLength": 10, "maxLength": 40},
  "session": {"type": "string", "pattern": "^osim:session:[^\\s]{1,120}$"}
 }
}
