  {"expect": {"ready": true, "place": "São Paulo", "camera.x": {"is": "$cx"}, "camera.y": {"is": "$cy"}, "camera.zoom": {"is": "$zoom"}, "center.x": {"is": "$centerx"}, "center.y": {"is": "$centery"}}}
 ]
